// Exact values for the demo's first step, so any change to the rules shows up

Test firstStepMatchesKnownValues = [
  Assert
    that: Flock demo step toString
    equals: """
      Boid at (0.9869999999999999, 0.054) moving (0.9869999999999999, 0.054)
      Boid at (1.0, 2.002) moving (0.0, 1.002)
      Boid at (3.003, 0.999) moving (1.003, 0.999)""" trimIndent
]

Test stepDoesNotMutate = [
  demo = Flock demo
  before = demo toString
  demo step
  Assert that: demo toString equals: before
]

Test boidIgnoresItself = [
  b = Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  Assert that: (b neighborsIn: {b} within: 50.0 fov: 360.0) count equals: 0
]

Test viewAngle = [
  // heading right, with one boid ahead, one to the side, one behind
  b = Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  ahead = Boid position: (Vec2 x: 3.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  side = Boid position: (Vec2 x: 0.0 y: 3.0) velocity: (Vec2 x: 1.0 y: 0.0)
  behind = Boid position: (Vec2 x: -3.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)

  Assert that: (b canSee: ahead fov: 180.0) equals: true
  Assert that: (b canSee: side fov: 180.0) equals: false
  Assert that: (b canSee: behind fov: 180.0) equals: false

  Assert that: (b canSee: side fov: 270.0) equals: true
  Assert that: (b canSee: behind fov: 270.0) equals: false

  Assert that: (b canSee: behind fov: 360.0) equals: true
  Assert that: (b canSee: ahead fov: 10.0) equals: true
]
