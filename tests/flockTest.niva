// Exact values for the demo's first step, so any change to the rules shows up

Test firstStepMatchesKnownValues = [
  Assert
    that: Flock demo step toString
    equals: """
      Boid at (0.9869999999999999, 0.054) moving (0.9869999999999999, 0.054)
      Boid at (1.0, 2.002) moving (0.0, 1.002)
      Boid at (3.003, 0.999) moving (1.003, 0.999)""" trimIndent
]

Test stepDoesNotMutate = [
  demo = Flock demo
  before = demo toString
  demo step
  Assert that: demo toString equals: before
]

Test boidIgnoresItself = [
  b = Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  Assert that: (b neighborsIn: {b} within: 50.0 fov: 360.0) count equals: 0
]

Test viewAngle = [
  // heading right, with one boid ahead, one to the side, one behind
  b = Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  ahead = Boid position: (Vec2 x: 3.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  side = Boid position: (Vec2 x: 0.0 y: 3.0) velocity: (Vec2 x: 1.0 y: 0.0)
  behind = Boid position: (Vec2 x: -3.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)

  Assert that: (b canSee: ahead fov: 180.0) equals: true
  Assert that: (b canSee: side fov: 180.0) equals: false
  Assert that: (b canSee: behind fov: 180.0) equals: false

  Assert that: (b canSee: side fov: 270.0) equals: true
  Assert that: (b canSee: behind fov: 270.0) equals: false

  Assert that: (b canSee: behind fov: 360.0) equals: true
  Assert that: (b canSee: ahead fov: 10.0) equals: true
]

Test blockersAreCloseAndAhead = [
  // heading right; only the boid close and straight ahead blocks
  b = Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  ahead = Boid position: (Vec2 x: 10.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  side = Boid position: (Vec2 x: 0.0 y: 10.0) velocity: (Vec2 x: 1.0 y: 0.0)
  behind = Boid position: (Vec2 x: -10.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  far = Boid position: (Vec2 x: 50.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  blockers = b neighborsIn: {b ahead side behind far} within: 40.0 fov: 90.0
  Assert that: blockers count equals: 1
]

Test clearViewAndBackOff = [
  b = Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  ahead = Boid position: (Vec2 x: 10.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0)
  // one unit sideways, and one unit back
  Assert that: (b stepAsideFrom: {ahead}) toString equals: "(0.0, -1.0)"
  Assert that: (b backOffFrom: {ahead}) toString equals: "(-1.0, 0.0)"

  // heading a little upward, the sideways step goes up too
  climbing = b velocity: (Vec2 x: 1.0 y: 0.2)
  Assert that: (climbing stepAsideFrom: {ahead}) y > 0.0 equals: true
]

Test resizedTo = [
  screen = Screen width: 100.0 height: 100.0
  demo = Flock demo
  fewer = demo resizedTo: 2 across: screen
  more = demo resizedTo: 5 across: screen
  Assert that: fewer boids count equals: 2
  Assert that: more boids count equals: 5
  // the boids already there stay as they were
  Assert that: fewer boids first toString equals: demo boids first toString
  Assert that: (more boids take: 3) toString equals: demo boids toString
  Assert that: (demo resizedTo: 3 across: screen) toString equals: demo toString
]
