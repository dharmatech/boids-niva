/// One slider: its label, range, and the value it's holding. ImGui writes
/// the value into `cell`. A weight slider is logarithmic, since the useful
/// weights span orders of magnitude.
type Knob
  label:  String
  min:    Float
  max:    Float
  format: String
  weight: Bool
  cell:   FloatArray

constructor Knob weight(label): String upTo(max): Float -> Knob =
  Knob
    label:  label
    min:    0.0f
    max:    max
    format: "%.4f"
    weight: true
    cell:   (FloatArray of: 0.0f)

constructor Knob range(label): String from(min): Float to(max): Float -> Knob =
  Knob
    label:  label
    min:    min
    max:    max
    format: "%.0f"
    weight: false
    cell:   (FloatArray of: min)

extend Knob [
  on value -> Double = cell first toDouble
  on value: Double -> Unit = cell first: value toFloat

  /// draws the slider; true if you moved it this frame
  on show -> Bool = [
    flags = weight ifTrue: [ImGuiSliderFlags Logarithmic] ifFalse: [0]
    ^ ImGui slider: label value: cell min: min max: max format: format flags: flags
  ]

  /// anywhere in the range
  on randomize -> Unit = this randomizeFrom: min toDouble

  /// anywhere from lo (or the slider's minimum, if that's higher) to the
  /// top; cubed for weights, so small ones come up about as often as
  /// they would on the log slider
  on randomizeFrom(lo): Double -> Unit = [
    bottom = lo > min toDouble ifTrue: [lo] ifFalse: [min toDouble]
    r = Random nextDouble
    t = weight ifTrue: [r * r * r] ifFalse: [r]
    this value: bottom + (t * (max toDouble - bottom))
  ]
]
