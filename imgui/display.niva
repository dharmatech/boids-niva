// Which windowing system to use, and how big to draw.
//
// Cocoa on macOS. On Linux, X11 by default (XWayland on a Wayland
// desktop): GNOME draws a normal title bar, which it won't do for a JVM
// app on native Wayland. BOIDS_WAYLAND=1 opts into native Wayland.
//
// The scale comes from the desktop (Xft.dpi on X11, the output scale on
// Wayland, the backing scale on macOS), like GTK and Qt. BOIDS_SCALE=1.5
// overrides it.

// platform: GLFW_PLATFORM_COCOA, _WAYLAND or _X11.
// scale: screen pixels per logical unit.
// unit: window coordinates per logical unit. X11 coordinates are pixels,
// so it's `scale`; Wayland coordinates are already scaled by the desktop.
// Cocoa gets `scale` for now; on a Retina screen it may need Wayland's
// (asked on PR #2).
type Display
  platform: Int
  scale:    Float
  unit:     Float

constructor Display open -> Display = [
  wayland = (System getenv: "BOIDS_WAYLAND") == "1"
  mac = (System osName) == "Mac OS X"
  platform = | true
             | mac     => GLFW GLFW_PLATFORM_COCOA
             | wayland => GLFW GLFW_PLATFORM_WAYLAND
             |=> GLFW GLFW_PLATFORM_X11

  GLFW initHint: GLFW GLFW_PLATFORM value: platform
  GLFW initialize

  desktop = GLFW primaryMonitorScale
  scale = (System getenv: "BOIDS_SCALE") unpack: [it toFloat] or: desktop
  ^ Display
    platform: platform
    scale:    scale
    unit:     (wayland ifTrue: [scale / desktop] ifFalse: [scale])
]

extend Display [
  /// ImGui's built-in font, rasterized at full resolution so it stays crisp
  on setUpImGui -> Unit = [
    font = ImFontConfig new
    font setSizePixels: 13.0f * scale
    io = ImGui getIO
    io getFonts addFontDefault: font
    io setFontGlobalScale: unit / scale
    ImGui getStyle scaleAllSizes: unit
  ]

  on toString -> String = [
    name = | platform
           | GLFW GLFW_PLATFORM_COCOA   => "Cocoa"
           | GLFW GLFW_PLATFORM_WAYLAND => "Wayland"
           |=> "X11"

    ^ name + ", scale " + scale toString + ", unit " + unit toString
  ]
]
