/// A slider for each Rules field, plus the speed limits from world/.
type RulesPanel
  cohesion:         Knob
  alignment:        Knob
  separation:       Knob
  cohesionRadius:   Knob
  alignmentRadius:  Knob
  separationRadius: Knob
  viewAngle:        Knob
  clearView:        Knob
  backOff:          Knob
  blockerRadius:    Knob
  blockerCone:      Knob
  minSpeed:         Knob
  maxSpeed:         Knob

constructor RulesPanel new -> RulesPanel = [
  // copy-with (`k format: …`) needs a variable as its receiver
  slowest = Knob range: "min speed" from: 0.0f to: 5.0f
  fastest = Knob range: "max speed" from: 0.5f to: 10.0f
  panel = RulesPanel
    cohesion:         (Knob weight: "cohesion"           upTo: 0.2f)
    alignment:        (Knob weight: "alignment"          upTo: 1.0f)
    separation:       (Knob weight: "separation"         upTo: 1.0f)
    clearView:        (Knob weight: "clear view"         upTo: 1.0f)
    backOff:          (Knob weight: "back off"           upTo: 1.0f)
    cohesionRadius:   (Knob range:  "cohesion radius"    from: 0.0f to: 200.0f)
    alignmentRadius:  (Knob range:  "alignment radius"   from: 0.0f to: 200.0f)
    separationRadius: (Knob range:  "separation radius"  from: 0.0f to: 50.0f)
    viewAngle:        (Knob range:  "view angle (deg)"   from: 0.0f to: 360.0f)
    blockerRadius:    (Knob range:  "blocker radius"     from: 0.0f to: 100.0f)
    blockerCone:      (Knob range:  "blocker cone (deg)" from: 0.0f to: 180.0f)
    minSpeed: (slowest format: "%.1f")
    maxSpeed: (fastest format: "%.1f")
  panel defaults
  ^ panel
]

extend RulesPanel [
  /// the sliders for the Rules fields; the speed limits come after them
  on ruleKnobs -> List::Knob = {
    cohesion   cohesionRadius
    alignment  alignmentRadius
    separation separationRadius
    viewAngle
    clearView backOff blockerRadius blockerCone
  }

  on rules -> Rules = Rules
    cohesion:         cohesion         value
    alignment:        alignment        value
    separation:       separation       value
    cohesionRadius:   cohesionRadius   value
    alignmentRadius:  alignmentRadius  value
    separationRadius: separationRadius value
    viewAngle:        viewAngle        value
    clearView:        clearView        value
    backOff:          backOff          value
    blockerRadius:    blockerRadius    value
    blockerCone:      blockerCone      value

  on defaults -> Unit = [
    r = Rules default
    cohesion         value: r cohesion
    alignment        value: r alignment
    separation       value: r separation
    cohesionRadius   value: r cohesionRadius
    alignmentRadius  value: r alignmentRadius
    separationRadius value: r separationRadius
    viewAngle        value: r viewAngle
    clearView        value: r clearView
    backOff          value: r backOff
    blockerRadius    value: r blockerRadius
    blockerCone      value: r blockerCone
    minSpeed         value: Flock minSpeed
    maxSpeed         value: Flock maxSpeed
  ]

  on randomize -> Unit = [
    this ruleKnobs forEach: [it randomize]
    minSpeed randomize
    // from min speed up, so the two never cross
    maxSpeed randomizeFrom: minSpeed value
  ]

  on show -> Unit = [
    this ruleKnobs forEach: [it show]
    minSpeed show
    fasterMoved = maxSpeed show
    // min speed can't pass max speed: the one you drag pushes the other
    minSpeed value > maxSpeed value ifTrue: [
      fasterMoved
        ifTrue:  [minSpeed value: maxSpeed value]
        ifFalse: [maxSpeed value: minSpeed value]
    ]
  ]
]
