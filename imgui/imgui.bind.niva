// Just the slice of imgui-java the renderer needs.
// Adapted from gavr's bazar: Programs/imgui-demo/imgui.bind.niva

Project loadPackages: {"io.github.spair:imgui-java-app:1.90.0"}

Bind package: "imgui" content: [
  type ImGui
  constructor ImGui [
    on getBackgroundDrawList -> ImDrawList
    on getIO -> ImGuiIO
    on getStyle -> ImGuiStyle

    @rename: "begin"
    /// create window
    on begin: String flags: Int -> Bool
    /// end of window
    on end -> Unit
    on text: String -> Unit

    on isKeyPressed: Int -> Bool
  ]

  type ImColor
  constructor ImColor [
    /// "#rrggbb" to imgui's packed ABGR Int
    on rgb: String -> Int
  ]

  type ImGuiIO
  extend ImGuiIO [
    on getDisplaySizeX -> Float
    on getDisplaySizeY -> Float
    on getFramerate -> Float
    on getFonts -> ImFontAtlas
    on setFontGlobalScale: Float -> Unit
  ]

  type ImGuiStyle
  extend ImGuiStyle [
    on scaleAllSizes: Float -> Unit
  ]

  type ImFont
  type ImFontConfig
  extend ImFontConfig [
    on setSizePixels: Float -> Unit
  ]

  type ImFontAtlas
  extend ImFontAtlas [
    on addFontDefault: ImFontConfig -> ImFont
  ]

  type ImDrawList
  extend ImDrawList [
    @rename: "addCircleFilled"
    on circleX: Float y: Float radius: Float color: Int -> Unit
    @rename: "addLine"
    on lineX1: Float y1: Float x2: Float y2: Float color: Int thickness: Float -> Unit
  ]
]

Bind package: "imgui.flag" content: [
  type ImGuiKey
  type ImGuiWindowFlags
] fields: [
  ImGuiKey Escape: Int
  ImGuiWindowFlags AlwaysAutoResize: Int
]

Bind package: "org.lwjgl.glfw" content: [
  type GLFW
  constructor GLFW [
    @rename: "glfwInitHint"
    on initHint: Int value: Int -> Unit
    @rename: "glfwInit"
    /// imgui-java calls this again later; a second call is a no-op
    on initialize -> Bool

    @emit: """run {
      val x = FloatArray(1); val y = FloatArray(1)
      org.lwjgl.glfw.GLFW.glfwGetMonitorContentScale(org.lwjgl.glfw.GLFW.glfwGetPrimaryMonitor(), x, y)
      x[0]
    }"""
    /// the desktop's scale: Xft.dpi / 96 on X11, the output scale on Wayland
    on primaryMonitorScale -> Float

    /// the window whose GL context is current, i.e. ours
    on glfwGetCurrentContext -> Long
    @rename: "glfwSetWindowShouldClose"
    on setShouldClose: Long to: Bool -> Unit
  ]
] fields: [
  GLFW GLFW_PLATFORM: Int GLFW_PLATFORM_X11: Int GLFW_PLATFORM_WAYLAND: Int
]

Bind package: "java.lang" content: [
  type System
  constructor System [
    on getenv: String -> String?
  ]
]

Bind package: "imgui.app" content: [
  type Configuration
  extend Configuration [
    on setTitle: String -> Unit
    on setWidth: Int -> Unit
    on setHeight: Int -> Unit
  ]

  // setup runs once ImGui exists but before its font atlas is built,
  // so it's where fonts and style go
  @emit: """
  object : Application() {
        override fun configure(it: Configuration) = $1()
        override fun initImGui(config: Configuration) { super.initImGui(config); $2() }
        override fun process() $3
    }
  """
  constructor ImGui configure: [Configuration ->] setup: [-> Unit] process: [-> Unit] -> ImGui

  type Application
  constructor Application launch: ImGui -> Unit
]
