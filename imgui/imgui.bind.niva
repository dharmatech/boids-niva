// Just the slice of imgui-java the renderer needs.
// Adapted from gavr's bazar: Programs/imgui-demo/imgui.bind.niva
// (MIT License, Copyright (c) 2024 gavr; see LICENSE-bazar)

Project loadPackages: {"io.github.spair:imgui-java-app:1.90.0"}

Bind package: "imgui" content: [
  type ImGui
  constructor ImGui [
    on getBackgroundDrawList -> ImDrawList
    on getIO -> ImGuiIO
    on getStyle -> ImGuiStyle

    @rename: "begin"
    /// create window
    on begin: String flags: Int -> Bool
    /// end of window
    on end -> Unit
    on text: String -> Unit
    /// text in the dimmer "disabled" color
    on textDisabled: String -> Unit
    on separator -> Unit
    on sameLine -> Unit
    on button: String -> Bool
    /// a header that folds what follows it; true while it's open.
    /// Starts closed.
    on collapsingHeader: String -> Bool

    @rename: "sliderFloat"
    /// edits value's one element in place; true if it moved
    on slider: String value: FloatArray min: Float max: Float format: String flags: Int -> Bool

    on isKeyPressed: Int -> Bool
    @rename: "isKeyPressed"
    /// repeat: false fires once per press, however long it's held
    on isKeyPressed: Int repeat: Bool -> Bool
  ]

  type ImColor
  constructor ImColor [
    /// "#rrggbb" to imgui's packed ABGR Int
    on rgb: String -> Int
  ]

  type ImGuiIO
  extend ImGuiIO [
    on getDisplaySizeX -> Float
    on getDisplaySizeY -> Float
    on getFramerate -> Float
    /// true while a text field has focus, e.g. a Ctrl+clicked slider
    on getWantTextInput -> Bool
    on getFonts -> ImFontAtlas
    on setFontGlobalScale: Float -> Unit
  ]

  type ImGuiStyle
  extend ImGuiStyle [
    on scaleAllSizes: Float -> Unit
  ]

  type ImFont
  type ImFontConfig
  extend ImFontConfig [
    on setSizePixels: Float -> Unit
  ]

  type ImFontAtlas
  extend ImFontAtlas [
    on addFontDefault: ImFontConfig -> ImFont
  ]

  type ImDrawList
  extend ImDrawList [
    @rename: "addCircleFilled"
    on circleX: Float y: Float radius: Float color: Int -> Unit
    @rename: "addLine"
    on lineX1: Float y1: Float x2: Float y2: Float color: Int thickness: Float -> Unit
  ]
]

Bind package: "imgui.flag" content: [
  type ImGuiKey
  type ImGuiWindowFlags
  type ImGuiSliderFlags
] fields: [
  ImGuiKey Escape: Int R: Int D: Int S: Int H: Int
  ImGuiWindowFlags AlwaysAutoResize: Int
  ImGuiSliderFlags Logarithmic: Int
]

Bind package: "org.lwjgl.glfw" content: [
  type GLFW
  constructor GLFW [
    @rename: "glfwInitHint"
    on initHint: Int value: Int -> Unit
    @rename: "glfwInit"
    /// imgui-java calls this again later; a second call is a no-op
    on initialize -> Bool

    @emit: """run {
      val x = FloatArray(1); val y = FloatArray(1)
      org.lwjgl.glfw.GLFW.glfwGetMonitorContentScale(org.lwjgl.glfw.GLFW.glfwGetPrimaryMonitor(), x, y)
      x[0]
    }"""
    /// the desktop's scale: Xft.dpi / 96 on X11, the output scale on
    /// Wayland, the backing scale on macOS
    on primaryMonitorScale -> Float

    /// the window whose GL context is current, i.e. ours
    on glfwGetCurrentContext -> Long
    @rename: "glfwSetWindowShouldClose"
    on setShouldClose: Long to: Bool -> Unit
  ]
] fields: [
  GLFW GLFW_PLATFORM: Int GLFW_PLATFORM_X11: Int GLFW_PLATFORM_WAYLAND: Int GLFW_PLATFORM_COCOA: Int
]

// ImGui's sliders write through a float[], so a one-element FloatArray
// is the box a slider's value lives in
Bind package: "kotlin" content: [
  type FloatArray
  @emit: "floatArrayOf($1)"
  constructor FloatArray of: Float -> FloatArray
  extend FloatArray [
    on first -> Float
    @emit: "$0.set(0, $1)"
    on first: Float -> Unit
  ]
]

Bind package: "kotlin.random" content: [
  type Random
  constructor Random [
    /// uniform in [0, 1)
    on nextDouble -> Double
  ]
]

Bind package: "java.lang" content: [
  type System
  constructor System [
    on getenv: String -> String?
    @emit: """java.lang.System.getProperty("os.name")"""
    on osName -> String
    on nanoTime -> Long
  ]
]

Bind package: "kotlin.text" content: [
  extend String [
    @emit: "$0.format(java.util.Locale.ROOT, $1)"
    /// "%.2f" format: 0.4161 is "0.42", with a dot in any locale. Bind
    /// the result to a name before using it in `+`: an @emit method as a
    /// binary operand miscompiles.
    on format: Double -> String
  ]
]

Bind package: "imgui.app" content: [
  type Configuration
  extend Configuration [
    on setTitle: String -> Unit
    on setWidth: Int -> Unit
    on setHeight: Int -> Unit
  ]

  // setup runs once ImGui exists but before its font atlas is built,
  // so it's where fonts and style go
  @emit: """
  object : Application() {
        override fun configure(it: Configuration) { $1() }
        override fun initImGui(config: Configuration) { super.initImGui(config); $2() }
        override fun process() $3
    }
  """
  constructor ImGui configure: [Configuration ->] setup: [-> Unit] process: [-> Unit] -> ImGui

  type Application
  constructor Application launch: ImGui -> Unit
]
