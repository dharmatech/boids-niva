/// The whole simulation state. Stepping returns a new Flock;
/// nothing is mutated.
type Flock boids: List::Boid

constructor Flock cohereRadius -> Double = 50.0
constructor Flock alignRadius -> Double = 50.0

/// three boids close together, for the headless demo and the tests
constructor Flock demo -> Flock = Flock boids: {
  (Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0))
  (Boid position: (Vec2 x: 1.0 y: 1.0) velocity: (Vec2 x: 0.0 y: 1.0))
  (Boid position: (Vec2 x: 2.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 1.0))
}

extend Flock [
  on step -> Flock = Flock boids: (boids map: [this steer: it])

  /// one boid's next state, given everyone's current state
  on steer(b): Boid -> Boid = [
    pull = b cohere: (b neighborsIn: boids within: Flock cohereRadius)
    match = b align: (b neighborsIn: boids within: Flock alignRadius)
    push = b separateFrom: boids
    ^ b advance: b velocity + pull + match + push
  ]

  on toString -> String = boids joinWith: "\n"
]
