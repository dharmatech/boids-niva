/// The whole simulation state: the boids and the rules they follow.
/// Stepping returns a new Flock; nothing is mutated.
type Flock boids: List::Boid rules: Rules

/// three boids close together, for the headless demo and the tests
constructor Flock demo -> Flock = Flock
  boids: {
    (Boid position: (Vec2 x: 0.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 0.0))
    (Boid position: (Vec2 x: 1.0 y: 1.0) velocity: (Vec2 x: 0.0 y: 1.0))
    (Boid position: (Vec2 x: 2.0 y: 0.0) velocity: (Vec2 x: 1.0 y: 1.0))
  }
  rules: Rules default

extend Flock [
  on step -> Flock = this boids: (boids map: [this steer: it])

  /// one boid's next state, given everyone's current state
  on steer(b): Boid -> Boid = [
    fov = rules viewAngle
    toCenter = b cohere: (b neighborsIn: boids within: rules cohesionRadius fov: fov)
    toHeading = b align: (b neighborsIn: boids within: rules alignmentRadius fov: fov)
    away = b separateFrom: boids within: rules separationRadius
    ^ b advance: b velocity + (toCenter * rules cohesion) + (toHeading * rules alignment) + (away * rules separation)
  ]

  on toString -> String = boids joinWith: "\n"
]
