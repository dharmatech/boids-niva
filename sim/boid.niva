/// One bird: where it is and where it's heading.
type Boid position: Vec2 velocity: Vec2

/// The rules' raw steering vectors. Flock steer: weights and adds them.
extend Boid [
  /// other is in our field of view: `fov` degrees wide, centered on our
  /// heading. A boid standing still sees everything.
  on canSee(other): Boid fov(fov): Double -> Bool = [
    h2 = velocity dot: velocity
    ^ (h2 == 0.0) || (fov >= 360.0)
      ifTrue: [true]
      ifFalse: [
        toOther = other position - position
        lengths = (h2 * (toOther dot: toOther)) sqrt
        halfAngle = fov / 2.0 * Double pi / 180.0
        c = halfAngle cos
        (velocity dot: toOther) > (c * lengths)
      ]
  ]

  /// the boids we can see that are closer than r, not counting ourselves
  on neighborsIn(flock): List::Boid within(r): Double fov(fov): Double -> List::Boid =
    flock filter: [
      d2 = position dist2: it position
      (d2 > 0.0) && (d2 < (r * r)) && (this canSee: it fov: fov)
    ]

  /// toward the center of the neighbors
  on cohere(others): List::Boid -> Vec2 = others isEmpty
    ifTrue: [Vec2 zero]
    ifFalse: [(others map: [it position]) mean - position]

  /// toward the neighbors' average velocity
  on align(others): List::Boid -> Vec2 = others isEmpty
    ifTrue: [Vec2 zero]
    ifFalse: [(others map: [it velocity]) mean - velocity]

  /// away from every boid closer than r, seen or not
  on separateFrom(flock): List::Boid within(r): Double -> Vec2 =
    flock inject: Vec2 zero into: [sum, other ->
      d2 = position dist2: other position
      (d2 > 0.0) && (d2 < (r * r))
        ifTrue: [sum + (position - other position)]
        ifFalse: [sum]
    ]

  /// a unit step sideways out from behind each blocker: square to the
  /// line between us, on the side we're heading
  on stepAsideFrom(blockers): List::Boid -> Vec2 =
    blockers inject: Vec2 zero into: [sum, other ->
      away = position - other position
      d = (away dot: away) sqrt
      quarterTurn = Vec2 x: 0.0 - away y y: away x
      side = (velocity dot: quarterTurn) < 0.0
        ifTrue: [quarterTurn * -1.0]
        ifFalse: [quarterTurn]
      sum + (side / d)
    ]

  /// a unit step straight away from each blocker
  on backOffFrom(blockers): List::Boid -> Vec2 =
    blockers inject: Vec2 zero into: [sum, other ->
      away = position - other position
      d = (away dot: away) sqrt
      sum + (away / d)
    ]

  on advance(newVelocity): Vec2 -> Boid =
    Boid position: position + newVelocity velocity: newVelocity

  on toString -> String = "Boid at $position moving $velocity"
]
