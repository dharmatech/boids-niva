# JVM crash logs (NVIDIA's EGL driver segfaults if the JVM exits with
# the window open on Wayland)
hs_err_pid*.log

# ImGui's saved window layout, written on every run
imgui.ini

# png/ output, regenerated by `niva run`
png/frame-*.png

# `niva build` output and `niva dev` / `> expr` debug data
*.jar
devModeData.json
