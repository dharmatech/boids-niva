// Runs the flock without a window and saves a snapshot every 100 steps:
// frame-0.png, frame-100.png, ... in this folder.

screen = Screen width: 900.0 height: 650.0
mut flock = Flock random: 150 across: screen

0 to: 400 do: [ frame ->
  frame % 100 == 0 ifTrue: [
    flock saveTo: "frame-" + frame toString + ".png" screen: screen
  ]
  flock <- flock stepOn: screen
]
