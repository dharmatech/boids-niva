// Screen-world rules the sim doesn't have, shared by the renderers.
// Niva methods aren't tied to the type declaration, so these extend
// Flock and Boid without touching sim/.

type Screen width: Double height: Double

/// The sim's boids only see ahead, so cohesion keeps pulling stragglers
/// forward and speed grows without bound (mean 1.6 -> 40 px/step over
/// 1000 steps). Classic boids cap the speed; so do we. This is the
/// default; the window has a slider for it.
constructor Flock maxSpeed -> Double = 4.0

/// Back off pushes boids away from whoever is ahead, and with nothing to
/// stop that they brake almost to a standstill. Flake's boids have a
/// minimum speed for this; so do we.
constructor Flock minSpeed -> Double = 1.0

/// how many boids the window starts with
constructor Flock boidCount -> Int = 150

/// a random Double in [lo, hi), two decimals
Double randomTo(hi): Double -> Double =
  this + ((0..<((hi - this) * 100.0) toInt) random toDouble / 100.0)

/// floor-mod, so negatives wrap to the far edge (Niva's % is remainder)
Double wrap(size): Double -> Double = (this % size + size) % size

/// n boids scattered over the screen, moving in random directions
constructor Flock random(n): Int across(screen): Screen -> Flock = Flock
  boids: ((1..n) map: [
    Boid
      position: (Vec2 x: (0.0 randomTo: screen width) y: (0.0 randomTo: screen height))
      velocity: (Vec2 x: (-2.0 randomTo: 2.0) y: (-2.0 randomTo: 2.0))
  ])
  rules: Rules default

extend Boid [
  /// at least lo (a boid standing still has no heading, so it stays put)
  on keepSpeedAbove(lo): Double -> Boid = [
    s2 = velocity dot: velocity
    ^ (s2 > 0.0) && (s2 < (lo * lo))
      ifTrue: [
        s = s2 sqrt
        this velocity: velocity * (lo / s)
      ]
      ifFalse: [this]
  ]

  on limitSpeed(max): Double -> Boid = [
    s2 = velocity dot: velocity
    ^ s2 > (max * max)
      ifTrue: [
        s = s2 sqrt
        this velocity: velocity * (max / s)
      ]
      ifFalse: [this]
  ]

  /// leaving one edge brings the boid back on the opposite edge
  on wrapTo(screen): Screen -> Boid =
    this position: (Vec2
      x: (position x wrap: screen width)
      y: (position y wrap: screen height))
]

extend Flock [
  /// one frame: a sim step, then the screen rules
  on stepOn(screen): Screen -> Flock =
    this stepOn: screen minSpeed: Flock minSpeed maxSpeed: Flock maxSpeed

  on stepOn(screen): Screen minSpeed(min): Double maxSpeed(max): Double -> Flock = [
    next = this step
    ^ next boids: (next boids map: [it keepSpeedAbove: min, limitSpeed: max, wrapTo: screen])
  ]

  /// n boids: the first n of these, or all of them plus random newcomers
  /// across the screen
  on resizedTo(n): Int across(screen): Screen -> Flock = [
    have = boids count
    n == have ifTrue: [^ this]
    ^ n < have
      ifTrue: [this boids: (boids take: n)]
      ifFalse: [
        newcomers = Flock random: n - have across: screen
        this boids: boids + newcomers boids
      ]
  ]
]
