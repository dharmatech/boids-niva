// Boids rendered with Dear ImGui (imgui-java), one sim step per frame.
// `niva run`. Keys: R randomize, D defaults, S scatter, H hide the panel,
// Esc quit. See display.niva for BOIDS_SCALE and BOIDS_WAYLAND.

display = Display open
"boids: $display" echo
u = display unit

// how many boids. Up to 500 keeps even the heaviest rules under a 60 Hz
// frame (11.7 ms a step at 500, 1.4 at 150); the cost grows as n².
population = Knob range: "boids" from: 10.0f to: 500.0f
population value: Flock boidCount toDouble

// the sim works in logical units; only drawing is scaled
mut flock = Flock random: Flock boidCount across: (Screen width: 900.0 height: 650.0)
panel = RulesPanel new
mut showPanel = true

body = ImColor rgb: "#f2c14e"
beak = ImColor rgb: "#e4572e"

app = ImGui
  configure: [
    it
      setTitle: "niva boids";
      setWidth: (900.0f * u) toInt;
      setHeight: (650.0f * u) toInt
  ]
  setup: [display setUpImGui]
  process: [
    io = ImGui getIO
    screen = Screen
      width: (io getDisplaySizeX / u) toDouble
      height: (io getDisplaySizeY / u) toDouble
    // the slider applies at once: extras go, newcomers appear at random
    sized = flock resizedTo: population value toInt across: screen
    flock <- (sized rules: panel rules)
      stepOn: screen
      minSpeed: panel minSpeed value
      maxSpeed: panel maxSpeed value

    draw = ImGui getBackgroundDrawList
    flock boids forEach: [b ->
      p = b position
      tip = p + (b velocity * 4.0)
      draw lineX1: p x toFloat * u y1: p y toFloat * u
           x2: tip x toFloat * u y2: tip y toFloat * u
           color: beak thickness: 2.0f * u
      draw circleX: p x toFloat * u y: p y toFloat * u radius: 3.0f * u color: body
    ]

    // new positions and headings; the rules carry over on the next frame
    scatter = [flock <- Flock random: population value toInt across: screen]

    showPanel ifTrue: [
      // always fit the text; imgui.ini only keeps where you dragged it
      ImGui begin: "flock" flags: ImGuiWindowFlags AlwaysAutoResize
      population show
      ImGui text: io getFramerate toInt toString + " fps"
      ImGui separator
      ImGui button: "Randomize (R)", ifTrue: [panel randomize]
      ImGui sameLine
      ImGui button: "Defaults (D)", ifTrue: [panel defaults]
      ImGui sameLine
      ImGui button: "Scatter (S)", ifTrue: [scatter do]
      ImGui textDisabled: "H hides this panel, Esc quits"
      // folded at first; above it, the buttons stay put when it opens
      ImGui collapsingHeader: "rules", ifTrue: [panel show]
      ImGui end
    ]

    // Keys work with the panel hidden too. They're off while a slider
    // takes typed input (Ctrl+click), so typing a value can't fire them,
    // and Esc there cancels the edit instead of quitting.
    io getWantTextInput ifFalse: [
      ImGui isKeyPressed: ImGuiKey R repeat: false, ifTrue: [panel randomize]
      ImGui isKeyPressed: ImGuiKey D repeat: false, ifTrue: [panel defaults]
      ImGui isKeyPressed: ImGuiKey S repeat: false, ifTrue: [scatter do]
      ImGui isKeyPressed: ImGuiKey H repeat: false, ifTrue: [showPanel <- showPanel not]

      // the same path as a close button. Exiting the JVM with the window
      // still open (Ctrl+C) makes NVIDIA's EGL driver segfault on Wayland.
      ImGui isKeyPressed: ImGuiKey Escape, ifTrue: [
        GLFW setShouldClose: GLFW glfwGetCurrentContext to: true
      ]
    ]
  ]

Application launch: app
