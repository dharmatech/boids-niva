// Boids rendered with Dear ImGui (imgui-java), one sim step per frame.
// `niva run`; Esc quits. See display.niva for BOIDS_SCALE and BOIDS_WAYLAND.

display = Display open
"boids: $display" echo
u = display unit

// the sim works in logical units; only drawing is scaled
mut flock = Flock random: 150 across: (Screen width: 900.0 height: 650.0)

body = ImColor rgb: "#f2c14e"
beak = ImColor rgb: "#e4572e"

app = ImGui
  configure: [
    it
      setTitle: "niva boids";
      setWidth: (900.0f * u) toInt;
      setHeight: (650.0f * u) toInt
  ]
  setup: [display setUpImGui]
  process: [
    io = ImGui getIO
    flock <- flock stepOn: (Screen
      width: (io getDisplaySizeX / u) toDouble
      height: (io getDisplaySizeY / u) toDouble)

    draw = ImGui getBackgroundDrawList
    flock boids forEach: [b ->
      p = b position
      tip = p + (b velocity * 4.0)
      draw lineX1: p x toFloat * u y1: p y toFloat * u
           x2: tip x toFloat * u y2: tip y toFloat * u
           color: beak thickness: 2.0f * u
      draw circleX: p x toFloat * u y: p y toFloat * u radius: 3.0f * u color: body
    ]

    // always fit the text; imgui.ini only keeps where you dragged it
    ImGui begin: "flock" flags: ImGuiWindowFlags AlwaysAutoResize
    ImGui text: flock boids count toString + " boids"
    ImGui text: io getFramerate toInt toString + " fps"
    ImGui end

    // the same path as a close button. Exiting the JVM with the window
    // still open (Ctrl+C) makes NVIDIA's EGL driver segfault on Wayland.
    ImGui isKeyPressed: ImGuiKey Escape, ifTrue: [
      GLFW setShouldClose: GLFW glfwGetCurrentContext to: true
    ]
  ]

Application launch: app
